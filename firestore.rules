rules_version = '2';

// Creation: each person can read and write only their own records, under users/{their id}.
// Nothing else in the database can be read or written by anyone.
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
